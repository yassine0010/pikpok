# Base URL of the PikPok API (no trailing slash).
#
# - iOS Simulator / `expo start --web`: http://localhost:3000 works out of the box.
# - Android emulator: `localhost` is the emulator itself — use
#   http://10.0.2.2:3000 (the emulator's alias for the host machine's loopback).
# - Physical device: use your dev machine's LAN IP, e.g. http://192.168.1.20:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Base URL of the FUTURE puzzle service (no trailing slash). This is a
# SEPARATE service from EXPO_PUBLIC_API_URL — the client calls
# `GET /puzzles` and `POST /puzzles/answer` against it with a Bearer token.
#
# Leaving it empty (the default) means the puzzle service is NOT configured:
# the app makes no puzzle network calls and the feed shows the honest
# "Puzzles are coming soon" unavailable state.
EXPO_PUBLIC_PUZZLE_API_URL=
