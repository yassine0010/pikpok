# API Server
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://pikpok:pikpok@localhost:5432/pikpok

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Application
APP_TIME_ZONE=UTC
RECENT_PUZZLE_WINDOW=100
QUEUE_RESERVATION_TTL_SECONDS=600

# Puzzle Rotation
ROTATION_ENABLED=true
ROTATION_INTERVAL_MINUTES=60

# Archive
ARCHIVE_PATH=./.local/archive