{
  "name": "pikpok",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "common"
  ],
  "scripts": {
    "dev:client": "npm run start --workspace=apps/client",
    "dev:api": "npm run dev --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "rotate": "npm run rotate --workspace=apps/api",
    "seed": "npm run seed --workspace=apps/api"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "ajv": "^8.20.0",
    "typescript": "~5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react-native": "0.74.5"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "react-native": "0.74.5"
  }
}
